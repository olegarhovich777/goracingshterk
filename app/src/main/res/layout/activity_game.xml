<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#808080"
    tools:context=".MainActivity">

    <!-- Верхняя дорога -->
    <View
        android:id="@+id/roadTop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#A9A9A9"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/roadDivider"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Разделитель -->
    <View
        android:id="@+id/roadDivider"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:background="#FFFFFF"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Нижняя дорога -->
    <View
        android:id="@+id/roadBottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#A9A9A9"
        app:layout_constraintTop_toBottomOf="@id/roadDivider"
        app:layout_constraintBottom_toTopOf="@id/buttonPanel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Финишная лента -->
    <ImageView
        android:id="@+id/finishLine"
        android:layout_width="40dp"
        android:layout_height="0dp"
        android:src="@drawable/finish_line"
        android:scaleType="fitXY"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Машина 1 (оранжевая, верх) -->
    <ImageView
        android:id="@+id/Car1"
        android:layout_width="80dp"
        android:layout_height="50dp"
        android:src="@drawable/car_orange"
        android:contentDescription="Машина 1"
        app:layout_constraintTop_toTopOf="@id/roadTop"
        app:layout_constraintBottom_toBottomOf="@id/roadTop"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp" />

    <!-- Машина 2 (розовая, низ) -->
    <ImageView
        android:id="@+id/Car2"
        android:layout_width="80dp"
        android:layout_height="50dp"
        android:src="@drawable/car_pink"
        android:contentDescription="Машина 2"
        app:layout_constraintTop_toTopOf="@id/roadBottom"
        app:layout_constraintBottom_toBottomOf="@id/roadBottom"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="16dp" />

    <!-- Текст результата -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Панель кнопок -->
    <LinearLayout
        android:id="@+id/buttonPanel"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#000000"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnDrive1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ЕХАТЬ"
            android:backgroundTint="#E91E63"
            android:textColor="#FFFFFF"
            android:onClick="Drive1" />

        <Button
            android:id="@+id/btnStart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="СТАРТ"
            android:backgroundTint="#008000"
            android:textColor="#FFFFFF"
            android:onClick="Start" />

        <Button
            android:id="@+id/btnDrive2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="ЕХАТЬ"
            android:backgroundTint="#F44336"
            android:textColor="#FFFFFF"
            android:onClick="Drive2" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>